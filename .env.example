# Скопируй этот файл в .env (он в .gitignore) и подставь свои значения.
# docker-compose автоматически подтянет .env из корня проекта.

# --- Обязательные для прода ---

# Длинная случайная строка. Сгенерируй: `openssl rand -hex 32`.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Пароль для пользователя БД Postgres (внутрисетевой, наружу не торчит,
# но всё равно лучше не оставлять "hse").
POSTGRES_PASSWORD=replace-me-with-strong-password

# Через запятую — домены, с которых разрешены запросы к API.
# Для совместного хостинга фронт+API на одном домене можно оставить домен один.
CORS_ORIGINS=https://forms.example.com

# --- Опциональные ---

# Токен бота, если используется Telegram Mini App auth. Иначе пусто.
TELEGRAM_BOT_TOKEN=
