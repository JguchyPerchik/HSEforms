# ──────────────────────────────────────────────────────────────────────────
#  Caddy reverse-proxy + статика Flutter Web для HSE Forms.
#
#  ВАЖНО перед первым запуском:
#   1. Заменить `hseforms.ru` ниже на твой реальный домен
#      (тот, чья A-запись в DNS направлена на IP этого сервера).
#   2. Открыть порты 80 и 443 в фаерволе хоста / облачной консоли.
#   3. `docker compose up --build -d` — Caddy автоматически выпустит
#      сертификат Let's Encrypt и обновит его перед истечением.
#
#  Этот файл смонтирован томом в docker-compose.yml, так что для смены
#  домена достаточно поменять строчку ниже и сделать
#  `docker compose restart frontend` — пересборка не нужна.
# ──────────────────────────────────────────────────────────────────────────

hseforms.ru {
    # /api/* -> FastAPI. handle_path срезает префикс, поэтому
    # /api/auth/login превращается в /auth/login для backend.
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Всё остальное — статика Flutter Web с SPA-fallback на index.html.
    #
    # КРИТИЧНО: эти три директивы ОБЯЗАНЫ быть внутри handle {} —
    # иначе `try_files` выполняется в верхнем скоупе РАНЬШЕ, чем
    # handle_path, и переписывает /api/auth/login в /index.html ещё
    # до того, как запрос успеет попасть в reverse_proxy. В итоге
    # POST уходит в file_server, и тот отвечает 405 Method Not Allowed.
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }

    encode zstd gzip

    # Длинный кеш для версионированных ассетов Flutter (main.dart.js и т.д.).
    @assets path_regexp \.(js|css|woff2?|svg|png|jpg|jpeg|ico)$
    header @assets Cache-Control "public, max-age=604800, immutable"
}
